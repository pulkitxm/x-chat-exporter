{
  "name": "x-chat-exporter",
  "version": "0.1.0",
  "description": "Browser extension that exports an X chat conversation to a standalone offline HTML page with all media",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "lint": "biome check .",
    "lint:fix": "biome lint . --write",
    "format": "biome format . --write && biome check . --fix",
    "format:check": "biome format . --check",
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "check-comments": "bun scripts/strip-comments.ts --check",
    "strip-comments": "bun scripts/strip-comments.ts",
    "check-em-dashes": "bun scripts/check-em-dashes.ts",
    "dead-code": "bunx knip@6",
    "cycles": "bunx madge@8 --circular --extensions ts src scripts",
    "verify": "bun run lint && bun run check-comments && bun run check-em-dashes && bun run dead-code && bun run cycles && bun run type-check && bun run test && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/bun": "^1.3.14",
    "@types/chrome": "^0.0.287",
    "typescript": "^5.7.2"
  }
}
